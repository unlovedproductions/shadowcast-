# ═══════════════════════════════════════════════════════════════════════
# ShadowCast — Environment Configuration
# by Unloved Productions | Forged in Passion
# ═══════════════════════════════════════════════════════════════════════
#
# ShadowCast is local-first. Ollama is the default LLM provider.
# Copy this file to .env and adjust only if needed.

# ─── CORS (comma-separated origins; do not use * in production) ───
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Forbidden: CORS_ALLOW_ALL with credentialed SPA (ignored if set; use CORS_ORIGINS).
# CORS_ALLOW_ALL=1

# ─── Internal service auth ───
# Optional on localhost. REQUIRED when HOST is non-loopback (e.g. 0.0.0.0).
# When HOST is non-loopback (or SHADOWCAST_REQUIRE_SERVICE_KEY=1), mutating
# generate/publish/social/cancel routes also require X-Service-Key.
# INTERNAL_SERVICE_SECRET=
# SHADOWCAST_REQUIRE_SERVICE_KEY=0
# Install: https://ollama.com/download
# Then run: ollama pull qwen2.5:14b-instruct-q5_K_M
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b-instruct-q5_K_M
OPENAI_API_KEY=not-needed
# Keep model loaded between batch LLM calls (native /api/chat). Default -1 = forever.
# Durations: 30m, 5m; seconds as int; off = Ollama server default (5m).
# SHADOWCAST_OLLAMA_KEEP_ALIVE=-1
#
# OTHER MODELS FOR YOUR GPU (16GB VRAM):
#   BEST QUALITY:  qwen2.5:14b-instruct-q5_K_M  (~12GB VRAM, best scripts)
#   FAST + GOOD:   llama3.1:8b-instruct-q6_K     (~7GB VRAM, quick batches)
#   ULTRA FAST:    phi3.5:3.8b-mini-instruct-q6_K (~4GB VRAM, rapid testing)
#   MAX QUALITY:   qwen2.5:32b-instruct-q4_K_M   (~20GB, uses CPU offload)

# ─── OPTION: LM Studio (local GUI) ───
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
# OPENAI_API_KEY=not-needed

# ─── OPTION: Custom local OpenAI-compatible API ───
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model-name
# OPENAI_API_KEY=not-needed

# ─── OPTION: OpenAI cloud (optional, paid ~$0.02/video) ───
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4.1-mini

# ─── Server Settings (localhost-only trust; do not use 0.0.0.0 unless intentional) ───
HOST=127.0.0.1
PORT=8000
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
SHADOWCAST_PUBLIC_BASE_URL=http://localhost:8000

# Style-rules RAG (default on). Set to 0 to disable doc retrieval in script prompts.
STYLE_RULES_RAG=1
# STYLE_RULES_CORPUS_DIR=eval/rag_corpus

# ─── Social OAuth (publish to YouTube, Instagram, Facebook, TikTok) ───
# YouTube (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client):
#   Enable: YouTube Data API v3 + YouTube Analytics API
#   Authorized redirect URI: http://localhost:8000/api/oauth/youtube/callback
#   After adding analytics scopes, reconnect YouTube on the Social page.
# Meta: redirect URI http://localhost:8000/api/oauth/meta/callback
# TikTok: redirect URI http://localhost:8000/api/oauth/tiktok/callback
# After editing .env, restart the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Required for OAuth token encryption (or INTERNAL_SERVICE_SECRET). No silent default key.
CREDENTIALS_ENCRYPTION_KEY=change-me-credentials-key
# CREDENTIALS_STORE_DIR=credentials
# Throwaway local only — never enable on a shared/networked host:
# SHADOWCAST_ALLOW_DEV_CREDENTIALS=1
# Promote APF trust-field gaps to hard 422 on generate (optional):
# SHADOWCAST_STRICT_PRODUCT_GATE=1
# Delete aged job dirs under backend/output/ on startup (days). Unset/0 = off.
# Skips running jobs, the "credentials" name, and root files like analytics.json.
# SHADOWCAST_OUTPUT_MAX_AGE_DAYS=14
# Concurrent products in a batch job (default 1 = sequential). Cap to product count.
# Phases within a product stay sequential. Raise only if CPU/GPU/disk can take it.
# SHADOWCAST_BATCH_WORKERS=2
# Final MoviePy encode codec: auto (prefer h264_nvenc when ffmpeg has it), libx264, or h264_nvenc.
# SHADOWCAST_FFMPEG_CODEC=auto
# SHADOWCAST_VIDEO_PRESET=medium
# TTS seam polish: inter-segment pause (s) and micro edge crossfade (s, max 0.12).
# SHADOWCAST_TTS_INTER_SEGMENT_PAUSE=0.35
# SHADOWCAST_TTS_CROSSFADE=0.04
# Optional JSON map of product/SKU → speakable form, e.g. {"XM5":"X M five"}
# SHADOWCAST_TTS_PRONUNCIATIONS=

# Optional YouTube Data API key for competitor title research (search.list).
# Without it, research uses free autocomplete only.
# YOUTUBE_API_KEY=
# GOOGLE_API_KEY=

# ─── APF / Mission Control handoff (must match APF and Mission Control .env) ───
INTERNAL_SERVICE_SECRET=change-me-local-secret

# ─── Sentry (optional; empty DSN disables the SDK) ───
# Backend project slug: shadowcast  |  Frontend project slug: shadowcast-web
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
