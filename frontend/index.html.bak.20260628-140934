    // ── Helpers ──────────────────────────────────────────────
    function esc(s) { if(!s)return''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function escJs(s) { if(!s)return''; return String(s).replace(/\\/g,'\\\\').replace(/`/g,'\\`').replace(/\$/g,'\\$'); }
    function slugify(t) { return t.trim().toLowerCase().replace(/[^\w\s-]/g,'').replace(/[\s_-]+/g,'_').replace(/^_|_$/g,'').substring(0,60)||'product'; }

    async function scrapeAmazon() {
        const url = document.getElementById('amazonUrl')?.value?.trim();
        if (!url) { showToast('Please paste an Amazon product URL'); return; }
        const btn = document.getElementById('scrapeBtn');
        const status = document.getElementById('scrapeStatus');
        btn.disabled = true; btn.textContent = 'Scraping...';
        status.style.display = 'block'; status.style.color = 'var(--pink)';
        status.textContent = 'Fetching product data from Amazon...';
        try {
            const form = new FormData(); form.append('url', url);
            const res = await fetch('/api/scrape-amazon', { method: 'POST', body: form });
            if (!res.ok) { const err = await res.json(); throw new Error(err.detail || 'Scrape failed'); }
            const data = await res.json();
            const d = data.data;
            if (d.product_name) { state.productName = d.product_name; const el = document.getElementById('productName'); if(el) el.value = d.product_name; }
            if (d.price) { state.price = d.price; const el = document.getElementById('price'); if(el) el.value = d.price; }
            if (d.key_features) { state.keyFeatures = d.key_features; const el = document.getElementById('keyFeatures'); if(el) el.value = d.key_features; }
            if (d.common_complaints) { state.commonComplaints = d.common_complaints; const el = document.getElementById('commonComplaints'); if(el) el.value = d.common_complaints; }
            if (d.common_praises) { state.commonPraises = d.common_praises; const el = document.getElementById('commonPraises'); if(el) el.value = d.common_praises; }
            let extra = '';
            if (d.star_rating) extra += `Rating: ${d.star_rating}/5 | `;
            if (d.number_of_reviews) extra += `${d.number_of_reviews} reviews | `;
            status.style.color = 'var(--green)';
            status.textContent = `Auto-filled! ${extra}${d.common_complaints ? 'Complaints found' : 'No complaints found'} | ${d.common_praises ? 'Praises found' : 'No praises found'}`;
            showToast('Product data auto-filled from Amazon!');
        } catch (e) {
            status.style.color = 'var(--red)';
            status.textContent = `Error: ${e.message}. You can still fill in fields manually.`;
            showToast('Amazon scrape failed — fill in fields manually');
        } finally {
            btn.disabled = false; btn.textContent = 'Auto-Fill';
        }
    }

    async function researchKeywords() {
        const productName = document.getElementById('productName')?.value?.trim();
        const niche = document.getElementById('niche')?.value?.trim();
        const query = productName || niche || '';
        if (!query) { showToast('Enter a product name or niche first'); return; }
        const btn = document.getElementById('researchBtn');
        const results = document.getElementById('keywordResults');
        btn.disabled = true; btn.textContent = 'Researching...';
        results.style.display = 'block';
        results.innerHTML = '<p style="color:var(--pink);font-size:13px;">Fetching YouTube keyword data... (this takes ~30 seconds)</p>';
        try {
            const form = new FormData(); form.append('query', query);
            const res = await fetch('/api/youtube-research', { method: 'POST', body: form });
            if (!res.ok) { const err = await res.json(); throw new Error(err.detail || 'Research failed'); }
            const data = await res.json();
            const d = data.data;
            // Auto-fill keywords field
            const tags = d.recommended_tags || [];
            if (tags.length > 0) {
                const kwEl = document.getElementById('keywords');
                if (kwEl) { kwEl.value = tags.join(', '); state.keywords = tags.join(', '); }
            }
            // Build results display
            let html = '<div style="background:var(--bg);border:1px solid var(--bg4);border-radius:8px;padding:14px;">';
            html += '<p style="font-size:13px;font-weight:600;color:var(--green);margin-bottom:10px;">Keywords auto-filled! Here\'s what YouTube users are searching for:</p>';
            if (d.autocomplete_suggestions?.length) {
                html += '<p style="font-size:12px;color:var(--pink);font-weight:600;margin-bottom:4px;">Top Autocomplete:</p>';
                html += '<div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px;">';
                d.autocomplete_suggestions.slice(0,10).forEach(s => { html += `<span style="background:var(--bg3);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--text2);cursor:pointer;" onclick="appendKeyword('${s.replace(/'/g,"\\'")}')">+ ${s}</span>`; });
                html += '</div>';
            }
            if (d.question_keywords?.length) {
                html += '<p style="font-size:12px;color:var(--pink);font-weight:600;margin-bottom:4px;">Question Keywords (great for titles):</p>';
                html += '<div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px;">';
                d.question_keywords.slice(0,15).forEach(s => { html += `<span style="background:var(--bg3);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--text2);cursor:pointer;" onclick="appendKeyword('${s.replace(/'/g,"\\'")}')">+ ${s}</span>`; });
                html += '</div>';
            }
            if (d.recommended_titles?.length) {
                html += '<p style="font-size:12px;color:var(--pink);font-weight:600;margin-bottom:4px;">Suggested Video Titles:</p>';
                d.recommended_titles.forEach(t => { html += `<p style="font-size:12px;color:var(--text);margin-left:8px;">• ${t}</p>`; });
            }
            html += '<p style="font-size:10px;color:var(--text2);margin-top:8px;">Click any keyword to add it to your list. ${d.long_tail_keywords?.length || 0} long-tail keywords found.</p>';
            html += '</div>';
            results.innerHTML = html;
            showToast(`Found ${tags.length} keywords + ${d.long_tail_keywords?.length || 0} long-tail terms!`);
        } catch (e) {
            results.innerHTML = `<p style="color:var(--red);font-size:13px;">Error: ${e.message}</p>`;
            showToast('Keyword research failed');
        } finally {
            btn.disabled = false; btn.textContent = '\ud83d\udd0d Research Keywords';
        }
    }

    function appendKeyword(kw) {
        const el = document.getElementById('keywords');
        if (!el) return;
