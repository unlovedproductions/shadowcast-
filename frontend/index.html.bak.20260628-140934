        const data = (pr.hooks||{})[state.activeTab] || {};
        const ytAssets = (data.youtube_assets||{})[state.activeFormat] || {};
        const slug = slugify(pr.product_name || 'product');

        return `
        <button class="new-gen-btn" onclick="resetToForm()">← New Generation</button>
