                <div class="form-group"><label>Product Category</label><input id="productCategory" value="${esc(state.productCategory)}" placeholder="e.g., Wireless Earbuds"></div>
                <div class="form-group full"><label>Competitor Products</label><input id="competitors" value="${esc(state.competitors)}" placeholder="Comma-separated: AirPods Pro 2, Sony WF-1000XM5"><span class="hint">Used for comparisons, eliminations, and VS battles</span></div>
