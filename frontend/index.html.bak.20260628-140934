    function parseCSVPreview(text) {
        const lines = text.split('\n').filter(l=>l.trim());
        if (lines.length < 2) { showToast('CSV needs a header row and at least one product row'); return; }
        const headers = lines[0].split(',').map(h=>h.trim().toLowerCase().replace(/\s+/g,'_').replace(/"/g,''));
        const products = [];
        for (let i=1; i<lines.length; i++) {
            const vals = parseCSVLine(lines[i]);
            if (!vals.length) continue;
            const row = {};
            headers.forEach((h,j)=> row[h] = (vals[j]||'').trim());
            if (!row.product_name) continue;
            products.push({
                product_name: row.product_name||'',
                niche: row.niche||'General',
                key_features: (row.key_features||'').split(',').map(s=>s.trim()).filter(Boolean),
                price: row.price||'$49.99',
                affiliate_link: row.affiliate_link||'[YOUR_AFFILIATE_LINK]',
                keywords: (row.keywords||'').split(',').map(s=>s.trim()).filter(Boolean),
                target_audience: row.target_audience||'General consumers',
                product_category: row.product_category||row.niche||'General',
                competitors: (row.competitors||'').split(',').map(s=>s.trim()).filter(Boolean),
                unique_selling_point: row.unique_selling_point||'',
                discount_info: row.discount_info||'',
                coupon_code: row.coupon_code||'',
