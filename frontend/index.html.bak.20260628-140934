        <div class="results-tabs">
            ${hookKeys.map(h=>`<button class="tab-btn ${state.activeTab===h?'active':''}" onclick="setTab('${h}')">${h.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</button>`).join('')}
