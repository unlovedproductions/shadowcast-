<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShadowCast — by Unloved Productions</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg: #0a0a0a; --bg2: #141414; --bg3: #1e1e1e; --bg4: #2a2a2a;
            --text: #e8e8e8; --text2: #aaa; --accent: #c4507a; --accent2: #d4698f;
            --green: #4caf50; --red: #f44336; --blue: #2196f3; --cyan: #c4507a;
            --purple: #9c27b0; --yellow: #d4698f; --radius: 10px;
            --pink: #c4507a; --pink-light: #d4698f; --pink-glow: rgba(196,80,122,.15);
        }
        body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { color: var(--accent2); }

        .header { background: linear-gradient(135deg, var(--bg2) 0%, #1a0a10 100%); border-bottom: 1px solid var(--pink); padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
        .header-left { display: flex; align-items: center; gap: 14px; }
        .logo-placeholder { width: 40px; height: 40px; border-radius: 8px; border: 2px dashed var(--pink); display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--pink); text-align: center; line-height: 1.1; }
        .logo-placeholder img { width: 100%; height: 100%; object-fit: contain; border-radius: 6px; }
        .footer { background: var(--bg2); border-top: 1px solid var(--bg3); padding: 20px 24px; text-align: center; margin-top: 40px; }
        .footer .company { font-size: 13px; color: var(--pink); font-weight: 600; }
        .footer .motto { font-size: 11px; color: var(--text2); font-style: italic; margin-top: 4px; }
        .footer .tagline { font-size: 10px; color: var(--text2); opacity: .6; margin-top: 6px; }
        .header h1 { font-size: 20px; font-weight: 700; }
        .header h1 span { color: var(--pink); }
        .header h1 .edition { font-size: 11px; color: var(--pink-light); font-weight: 400; display: block; margin-top: 2px; }
        .header-right { display: flex; gap: 12px; align-items: center; }
        .settings-btn { background: var(--bg3); border: 1px solid var(--bg4); color: var(--text2); padding: 8px 16px; border-radius: var(--radius); cursor: pointer; font-size: 13px; transition: all .2s; }
        .settings-btn:hover { background: var(--bg4); color: var(--text); }
        .provider-badge { background: var(--bg3); padding: 4px 10px; border-radius: 20px; font-size: 12px; color: var(--cyan); }

        .container { max-width: 1200px; margin: 0 auto; padding: 24px; }

        .card { background: var(--bg2); border: 1px solid var(--bg3); border-radius: var(--radius); padding: 24px; margin-bottom: 20px; }
        .card h2 { font-size: 16px; font-weight: 600; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .card h2 .num { background: var(--accent); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
        .card h2 .badge { font-size: 10px; background: var(--cyan); color: #000; padding: 2px 8px; border-radius: 10px; font-weight: 700; margin-left: 8px; }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .form-group.full { grid-column: 1 / -1; }
        label { font-size: 13px; color: var(--text2); font-weight: 500; }
        label .req { color: var(--accent); }
        label .trust { color: var(--green); font-size: 10px; font-weight: 700; }
        input, textarea, select { background: var(--bg); border: 1px solid var(--bg4); color: var(--text); padding: 10px 14px; border-radius: 8px; font-size: 14px; font-family: inherit; transition: border .2s; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }
        textarea { resize: vertical; min-height: 60px; }
        .hint { font-size: 11px; color: var(--text2); opacity: .7; }
        .hint-green { font-size: 11px; color: var(--green); opacity: .85; }

        .section-divider { border: none; border-top: 1px dashed var(--bg4); margin: 20px 0 16px; }
        .section-label { font-size: 12px; font-weight: 700; color: var(--cyan); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }

        .mode-tabs { display: flex; gap: 0; margin-bottom: 20px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--bg4); }
        .mode-tab { flex: 1; padding: 14px; text-align: center; cursor: pointer; font-size: 14px; font-weight: 600; background: var(--bg2); color: var(--text2); transition: all .2s; border: none; }
        .mode-tab:hover { background: var(--bg3); }
        .mode-tab.active { background: var(--accent); color: #fff; }

        .upload-zone { border: 2px dashed var(--bg4); border-radius: var(--radius); padding: 40px; text-align: center; cursor: pointer; transition: all .2s; position: relative; }
        .upload-zone:hover, .upload-zone.dragover { border-color: var(--pink); background: var(--pink-glow); }
        .upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
        .upload-zone .icon { font-size: 40px; margin-bottom: 12px; }
        .upload-zone p { font-size: 14px; color: var(--text2); }
        .upload-zone .formats { font-size: 12px; color: var(--text2); opacity: .6; margin-top: 6px; }
        .upload-actions { display: flex; gap: 12px; margin-top: 16px; justify-content: center; flex-wrap: wrap; }
        .upload-actions button { padding: 8px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; }
        .btn-template { background: var(--blue); color: #fff; }
        .btn-gsheet { background: var(--green); color: #fff; }
        .btn-template:hover, .btn-gsheet:hover { opacity: .85; }
        .preview-table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 12px; }
        .preview-table th { background: var(--bg3); color: var(--text2); padding: 8px 10px; text-align: left; font-weight: 600; }
        .preview-table td { padding: 8px 10px; border-bottom: 1px solid var(--bg3); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .preview-table tr:hover td { background: var(--bg3); }
        .product-count { display: inline-block; background: var(--accent); color: #fff; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; margin-left: 8px; }

        .hook-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
        .hook-option { background: var(--bg); border: 2px solid var(--bg4); border-radius: var(--radius); padding: 14px; cursor: pointer; transition: all .2s; position: relative; }
        .hook-option:hover { border-color: var(--accent); }
        .hook-option.selected { border-color: var(--pink); background: var(--pink-glow); }
        .hook-option h3 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
        .hook-option p { font-size: 11px; color: var(--text2); line-height: 1.4; }
        .hook-option .adv-badge { position: absolute; top: 8px; right: 8px; font-size: 9px; background: var(--yellow); color: #000; padding: 1px 6px; border-radius: 8px; font-weight: 700; }
        .select-all-btn { background: none; border: 1px solid var(--bg4); color: var(--text2); padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 12px; margin-bottom: 10px; }
        .select-all-btn:hover { border-color: var(--accent); color: var(--accent); }

        .style-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; margin-top: 10px; }
        .style-option { background: var(--bg); border: 2px solid var(--bg4); border-radius: var(--radius); padding: 14px; cursor: pointer; transition: all .2s; }
        .style-option:hover { border-color: var(--pink); }
        .style-option.selected { border-color: var(--pink); background: var(--pink-glow); }
        .style-option h3 { font-size: 13px; font-weight: 600; margin-bottom: 4px; color: var(--pink); }
        .style-option p { font-size: 11px; color: var(--text2); line-height: 1.4; }

        .format-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .format-option { background: var(--bg); border: 2px solid var(--bg4); border-radius: var(--radius); padding: 16px; cursor: pointer; text-align: center; transition: all .2s; }
        .format-option:hover { border-color: var(--accent); }
        .format-option.selected { border-color: var(--pink); background: var(--pink-glow); }
        .format-option .icon { font-size: 28px; margin-bottom: 6px; }
        .format-option h3 { font-size: 13px; font-weight: 600; }
        .format-option p { font-size: 11px; color: var(--text2); }

        .btn-primary { background: var(--accent); color: #fff; border: none; padding: 14px 32px; border-radius: var(--radius); font-size: 16px; font-weight: 700; cursor: pointer; transition: all .2s; width: 100%; }
        .btn-primary:hover { background: var(--accent2); transform: translateY(-1px); }
        .btn-primary:disabled { opacity: .5; cursor: not-allowed; transform: none; }
        .btn-sm { padding: 6px 14px; font-size: 12px; border-radius: 6px; cursor: pointer; border: none; font-weight: 600; }
        .btn-download { background: var(--green); color: #fff; }
        .btn-copy { background: var(--blue); color: #fff; }
        .btn-copy:hover, .btn-download:hover { opacity: .85; }

        .progress-section { text-align: center; padding: 40px; }
        .progress-bar-bg { background: var(--bg); border-radius: 20px; height: 12px; overflow: hidden; margin: 20px 0; }
        .progress-bar { background: linear-gradient(90deg, var(--pink), var(--pink-light)); height: 100%; border-radius: 20px; transition: width .5s ease; }
        .progress-text { font-size: 14px; color: var(--text2); }
        .progress-pct { font-size: 36px; font-weight: 700; color: var(--pink); }
        .spinner { display: inline-block; width: 40px; height: 40px; border: 3px solid var(--bg4); border-top-color: var(--pink); border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 16px; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .results-tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
        .tab-btn { background: var(--bg); border: 1px solid var(--bg4); color: var(--text2); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all .2s; }
        .tab-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
        .tab-btn.product-tab.active { background: var(--purple); border-color: var(--purple); }
        .result-block { background: var(--bg); border: 1px solid var(--bg3); border-radius: var(--radius); padding: 16px; margin-bottom: 12px; }
        .result-block h3 { font-size: 14px; font-weight: 600; margin-bottom: 8px; color: var(--accent); }
        .result-block .content { font-size: 13px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
        .result-block .actions { display: flex; gap: 8px; margin-top: 10px; }
        .tag-list { display: flex; flex-wrap: wrap; gap: 6px; }
        .tag { background: var(--bg3); padding: 3px 10px; border-radius: 20px; font-size: 11px; color: var(--text2); }
        .video-player { width: 100%; max-width: 480px; border-radius: var(--radius); background: #000; }

        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.7); display: flex; align-items: center; justify-content: center; z-index: 100; }
        .modal { background: var(--bg2); border: 1px solid var(--bg3); border-radius: 12px; padding: 28px; width: 90%; max-width: 560px; max-height: 90vh; overflow-y: auto; }
        .modal h2 { font-size: 18px; margin-bottom: 20px; }
        .modal .form-group { margin-bottom: 14px; }
        .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
        .modal-actions button { flex: 1; padding: 10px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; }
        .modal-actions .save { background: var(--accent); color: #fff; }
        .modal-actions .cancel { background: var(--bg4); color: var(--text); }
        .model-rec { background: var(--bg); border: 1px solid var(--bg3); border-radius: 8px; padding: 10px; margin-top: 8px; font-size: 11px; }
        .model-rec table { width: 100%; border-collapse: collapse; }
        .model-rec th { text-align: left; color: var(--text2); padding: 3px 6px; font-size: 10px; }
        .model-rec td { padding: 3px 6px; font-size: 11px; }
        .model-rec .pick { cursor: pointer; color: var(--cyan); text-decoration: underline; }

        .new-gen-btn { background: var(--bg3); border: 1px solid var(--bg4); color: var(--text); padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; margin-bottom: 20px; }
        .new-gen-btn:hover { background: var(--bg4); }

        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .format-grid { grid-template-columns: 1fr; }
            .hook-grid { grid-template-columns: 1fr 1fr; }
            .style-grid { grid-template-columns: 1fr 1fr; }
            .mode-tabs { flex-direction: column; }
        }

        .toast { position: fixed; bottom: 24px; right: 24px; background: var(--green); color: #fff; padding: 12px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; z-index: 200; animation: fadeInUp .3s ease; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Navigation */
        .nav-bar { display: flex; gap: 0; border-bottom: 2px solid var(--bg3); margin-bottom: 24px; }
        .nav-item { padding: 12px 24px; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--text2); border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all .2s; }
        .nav-item:hover { color: var(--text); }
        .nav-item.active { color: var(--pink); border-bottom-color: var(--pink); }
        .nav-item .nav-badge { background: var(--pink); color: #fff; font-size: 10px; padding: 1px 6px; border-radius: 10px; margin-left: 6px; }

        /* Dashboard Stats */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card { background: var(--bg2); border: 1px solid var(--bg3); border-radius: var(--radius); padding: 20px; text-align: center; }
        .stat-card .stat-value { font-size: 32px; font-weight: 700; color: var(--pink); }
        .stat-card .stat-label { font-size: 12px; color: var(--text2); margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }
        .stat-card .stat-sub { font-size: 11px; color: var(--text2); margin-top: 6px; }
        .stat-card.green .stat-value { color: var(--green); }
        .stat-card.blue .stat-value { color: var(--blue); }
        .stat-card.purple .stat-value { color: var(--purple); }

        /* Performance Table */
        .perf-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .perf-table th { background: var(--bg3); color: var(--text2); padding: 10px 14px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; }
        .perf-table td { padding: 10px 14px; border-bottom: 1px solid var(--bg3); }
        .perf-table tr:hover td { background: var(--bg3); }
        .perf-bar { height: 8px; background: var(--bg4); border-radius: 4px; overflow: hidden; min-width: 80px; }
        .perf-bar-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--pink), var(--pink-light)); }

        /* Social Posting */
        .platform-card { background: var(--bg2); border: 1px solid var(--bg3); border-radius: var(--radius); padding: 20px; display: flex; align-items: center; gap: 16px; }
        .platform-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; }
        .platform-icon.ig { background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); color: #fff; }
        .platform-icon.tt { background: #000; color: #fff; border: 1px solid #333; }
        .platform-info { flex: 1; }
        .platform-info h3 { font-size: 15px; font-weight: 600; margin-bottom: 2px; }
        .platform-info .status { font-size: 12px; }
        .status-configured { color: var(--green); }
        .status-not-configured { color: var(--red); }
        .platform-actions { display: flex; gap: 8px; }

        .queue-item { background: var(--bg); border: 1px solid var(--bg3); border-radius: 8px; padding: 14px; margin-bottom: 10px; display: flex; align-items: center; gap: 14px; }
        .queue-item .qi-platform { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase; }
        .queue-item .qi-platform.ig { background: #dc2743; color: #fff; }
        .queue-item .qi-platform.tt { background: #000; color: #fff; }
        .queue-item .qi-info { flex: 1; }
        .queue-item .qi-info .qi-caption { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; }
        .queue-item .qi-info .qi-time { font-size: 11px; color: var(--text2); margin-top: 2px; }

        .empty-state { text-align: center; padding: 40px; color: var(--text2); }
        .empty-state .empty-icon { font-size: 48px; margin-bottom: 12px; opacity: .5; }
        .empty-state p { font-size: 14px; }
        .empty-state .empty-hint { font-size: 12px; margin-top: 8px; opacity: .6; }

        .metric-input-row { display: flex; gap: 10px; align-items: end; margin-bottom: 12px; }
        .metric-input-row .form-group { flex: 1; margin-bottom: 0; }
        .metric-input-row button { height: 40px; white-space: nowrap; }

        /* Nav Buttons */
        .nav-btn { padding: 12px 24px; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--text2); background: none; border: none; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all .2s; display: flex; align-items: center; gap: 6px; }
        .nav-btn:hover { color: var(--text); }
        .nav-btn.active { color: var(--pink); border-bottom-color: var(--pink); }
        .nav-icon { font-size: 16px; }

        /* Stat Grid */
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 20px; }

        /* Analytics Table */
        .analytics-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .analytics-table th { background: var(--bg3); color: var(--text2); padding: 10px 14px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; }
        .analytics-table td { padding: 10px 14px; border-bottom: 1px solid var(--bg3); }
        .analytics-table tr:hover td { background: rgba(196,80,122,.05); }

        /* Hook Badge */
        .hook-badge { background: var(--pink-glow); color: var(--pink); padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
    </style>
</head>
<body>
    <div id="app"></div>

    <script>
    const API = window.location.origin + '/api';

    let state = {
        page: 'form',
        mode: 'single',
        showSettings: false,
        llmProvider: 'openai', llmApiKey: '', llmBaseUrl: '', llmModel: '',
        providerPresets: {},
        // Single product — core
        productName: '', niche: '', keyFeatures: '', price: '',
        affiliateLink: '', keywords: '', targetAudience: '',
        productCategory: '', competitors: '', usp: '',
        discountInfo: '', couponCode: '',
        // Single product — trust-based
        commonComplaints: '', commonPraises: '', whoNotFor: '',
        seriesName: '', priceComparison: '',
        // Content style
        contentStyle: 'honest_review',
        // Batch
        batchProducts: [],
        batchFileName: '',
        // Selections
        selectedHooks: ['curiosity'],
        selectedFormats: ['short_form', 'long_form'],
        audioMood: 'chill',
        audioEnabled: true,
        // Job
        jobId: null, jobMode: 'single', progress: 0, currentStep: '', jobStatus: '',
        results: null, batchResults: null, errors: [],
        // Results view
        activeTab: null, activeFormat: 'short_form', activeProductIdx: 0,
        // Navigation
        navPage: 'generate',
        // Analytics
        analyticsData: null, analyticsLoading: false,
        trackVideoId: '', trackProduct: '', trackHook: '', trackFormat: '',
        metricVideoId: '', metricType: 'views', metricValue: '',
        // Social
        socialStatus: null, socialLoading: false,
        postingQueue: [], queueLoading: false,
        socialPostPlatform: 'instagram', socialPostVideo: '', socialPostCaption: '', socialPostHashtags: '', socialPostSchedule: '',
    };

    const hooks = [
        { id: 'curiosity', name: 'Curiosity', desc: 'Provocative questions, surprising reveals that make viewers click', adv: false },
        { id: 'problem_agitation', name: 'Problem-Agitation', desc: 'Pain point \u2192 agitate \u2192 tease the solution', adv: false },
        { id: 'listicle', name: 'Listicle', desc: 'Top X reasons / numbered format for easy consumption', adv: false },
        { id: 'urgency', name: 'Urgency', desc: 'FOMO, limited deals, time pressure to drive action', adv: false },
        { id: 'contrarian', name: 'Contrarian', desc: 'Challenge popular opinions, spark debate', adv: false },
        { id: 'data_bomb', name: 'Data Bomb', desc: 'Open with a surprising statistic for instant credibility', adv: true },
        { id: 'confession', name: 'Confession', desc: 'Admit a past mistake to build trust and curiosity', adv: true },
        { id: 'comparison_trap', name: 'Comparison Trap', desc: 'Price comparison that makes viewers feel smart', adv: true },
        { id: 'myth_buster', name: 'Myth Buster', desc: 'Challenge conventional wisdom to spark engagement', adv: true },
    ];

    const contentStyles = {
        honest_review: { name: 'Honest Review', desc: 'Balanced pros AND cons. "Who This Is NOT For" section. Builds trust.' },
        elimination: { name: 'Elimination Round', desc: 'Show rejected products, then reveal the winner. Massive credibility.' },
        worth_it_or_waste: { name: 'Worth It or Waste?', desc: 'Test a hyped product against its claims. Series format.' },
        budget_challenge: { name: 'Budget Challenge', desc: 'Best product under a price limit. Relatable for budget audiences.' },
        vs_battle: { name: 'VS Battle', desc: 'Side-by-side comparison. Spec breakdown. Clear winner.' },
        standard: { name: 'Standard Promo', desc: 'Classic features + benefits + CTA promotion.' },
    };

    // ── Render ───────────────────────────────────────────────
    function render() {
        const app = document.getElementById('app');
        let html = renderHeader() + '<div class="container">';
        html += renderNavBar();
        if (state.navPage === 'generate') {
            if (state.page === 'form') html += renderForm();
            else if (state.page === 'progress') html += renderProgress();
            else html += renderResults();
        } else if (state.navPage === 'analytics') {
            html += renderAnalyticsPage();
        } else if (state.navPage === 'social') {
            html += renderSocialPage();
        }
        html += '</div>';
        html += renderFooter();
        if (state.showSettings) html += renderSettingsModal();
        app.innerHTML = html;
        attachEvents();
    }

    function renderHeader() {
        const pn = state.providerPresets[state.llmProvider]?.name || state.llmProvider;
        return `<div class="header">
            <div class="header-left">
