                series_name: row.series_name||'',
                price_comparison: row.price_comparison||'',
                content_style: row.content_style||'honest_review',
            });
        }
        state.batchProducts = products;
        render();
        if (products.length) showToast(`Found ${products.length} products!`);
        else showToast('No valid products found. Check your CSV format.');
    }

    function parseCSVLine(line) {
        const result=[]; let current=''; let inQuotes=false;
        for(let i=0;i<line.length;i++){
            const c=line[i];
            if(c==='"'){inQuotes=!inQuotes;}
            else if(c===','&&!inQuotes){result.push(current);current='';}
            else{current+=c;}
        }
        result.push(current);
        return result;
    }

